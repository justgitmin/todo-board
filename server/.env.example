# 네이버웍스 Developer Console에서 발급받은 값
NAVER_WORKS_CLIENT_ID=your_client_id
NAVER_WORKS_CLIENT_SECRET=your_client_secret

# OAuth 콜백 URL (이 서버의 주소 + /auth/callback)
NAVER_WORKS_REDIRECT_URI=http://localhost:3001/auth/callback

# 프론트엔드 URL
FRONTEND_URL=http://localhost:5173

# YouTube Data API v3 키
YOUTUBE_API_KEY=your_youtube_api_key_here

# 서버 포트
PORT=3001
